<?xml version="1.0" encoding="utf-8"?>
<!--
  BabelTower v3 — 设置 Tab 完整 UI
  由 lct_settings.js 通过 BLoadLayout 注入 Escape Menu 的设置容器(id="settings",实机实证)。
  本文件的脚本运行在 Escape Menu 的 JS context(与宿主 chat/hudchat context 不通),
  与宿主的通信走根面板属性 "lct_cfg"(JSON 字符串),详见 lct_settings_ui.js。
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/lct_settings.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/lct_settings_ui.vjs_c" />
	</scripts>
	<!-- 注意:Panorama 布局编译器禁止 <root> 顶层面板携带 id 属性 -->
	<Panel class="LCTTab">
		<Panel class="LCTHeader">
			<Label class="LCTHeaderText" text="BABELTOWER 翻译" />
			<Label id="LCTBuildId" class="LCTBuildId" text="" />
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="启用翻译" />
					<Label class="LCTRowHint" text="关闭后所有消息保留原文" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTTglEnabled" class="LCTToggle" onactivate="LCTUIToggle('enabled');">
						<Panel class="LCTToggleKnob" />
					</Button>
				</Panel>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="目标语言" />
					<Label class="LCTRowHint" text="把别人的消息翻译成这个语言" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTSelTarget" class="LCTSelect" onactivate="LCTUIMenu('targetLanguage');">
						<Label id="LCTSelTargetLabel" class="LCTSelectLabel" text="简体中文" />
						<Label class="LCTSelectArrow" text="▼" />
					</Button>
				</Panel>
			</Panel>
			<Panel id="LCTMenuTarget" class="LCTMenu">
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','zh-Hans','简体中文');"><Label class="LCTMenuOptionLabel" text="简体中文 (zh-Hans)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','zh-Hant','繁體中文');"><Label class="LCTMenuOptionLabel" text="繁體中文 (zh-Hant)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','en','English');"><Label class="LCTMenuOptionLabel" text="English (en)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','ja','日本語');"><Label class="LCTMenuOptionLabel" text="日本語 (ja)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','ko','한국어');"><Label class="LCTMenuOptionLabel" text="한국어 (ko)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','fr','Français');"><Label class="LCTMenuOptionLabel" text="Français (fr)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','de','Deutsch');"><Label class="LCTMenuOptionLabel" text="Deutsch (de)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('targetLanguage','es','Español');"><Label class="LCTMenuOptionLabel" text="Español (es)" /></Button>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="显示模式" />
					<Label class="LCTRowHint" text="译文下方是否保留原文" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTSelDisplay" class="LCTSelect" onactivate="LCTUIMenu('displayMode');">
						<Label id="LCTSelDisplayLabel" class="LCTSelectLabel" text="双语" />
						<Label class="LCTSelectArrow" text="▼" />
					</Button>
				</Panel>
			</Panel>
			<Panel id="LCTMenuDisplay" class="LCTMenu">
				<Button class="LCTMenuOption" onactivate="LCTUIPick('displayMode','bilingual','双语');"><Label class="LCTMenuOptionLabel" text="双语 (原文 + 译文)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('displayMode','translation_only','仅译文');"><Label class="LCTMenuOptionLabel" text="仅译文" /></Button>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="发送前翻译" />
					<Label class="LCTRowHint" text="把自己打的消息先翻成目标语言再发出" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTSelOutgoing" class="LCTSelect" onactivate="LCTUIMenu('outgoing');">
						<Label id="LCTSelOutgoingLabel" class="LCTSelectLabel" text="关" />
						<Label class="LCTSelectArrow" text="▼" />
					</Button>
				</Panel>
			</Panel>
			<Panel id="LCTMenuOutgoing" class="LCTMenu">
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoing','off','关');"><Label class="LCTMenuOptionLabel" text="关 (发原文)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoing','translation','仅译文');"><Label class="LCTMenuOptionLabel" text="仅译文" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoing','bilingual','双语');"><Label class="LCTMenuOptionLabel" text="双语 (原文 | 译文)" /></Button>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="发送目标语言" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTSelOutTarget" class="LCTSelect" onactivate="LCTUIMenu('outgoingTarget');">
						<Label id="LCTSelOutTargetLabel" class="LCTSelectLabel" text="English" />
						<Label class="LCTSelectArrow" text="▼" />
					</Button>
				</Panel>
			</Panel>
			<Panel id="LCTMenuOutTarget" class="LCTMenu">
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoingTarget','en','English');"><Label class="LCTMenuOptionLabel" text="English (en)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoingTarget','zh-Hans','简体中文');"><Label class="LCTMenuOptionLabel" text="简体中文 (zh-Hans)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoingTarget','zh-Hant','繁體中文');"><Label class="LCTMenuOptionLabel" text="繁體中文 (zh-Hant)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoingTarget','ja','日本語');"><Label class="LCTMenuOptionLabel" text="日本語 (ja)" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('outgoingTarget','ko','한국어');"><Label class="LCTMenuOptionLabel" text="한국어 (ko)" /></Button>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="强制翻译" />
					<Label class="LCTRowHint" text="跳过语言判断,一律翻译" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTTglForce" class="LCTToggle" onactivate="LCTUIToggle('force');">
						<Panel class="LCTToggleKnob" />
					</Button>
				</Panel>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="翻译自己的消息" />
					<Label class="LCTRowHint" text="自己发出的消息也显示译文" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTTglTranslateOwn" class="LCTToggle" onactivate="LCTUIToggle('translateOwn');">
						<Panel class="LCTToggleKnob" />
					</Button>
				</Panel>
			</Panel>
		</Panel>

		<Panel class="LCTRow">
			<Panel class="LCTLine">
				<Panel class="LCTRowBody">
					<Label class="LCTRowLabel" text="翻译超时" />
				</Panel>
				<Panel class="LCTRight">
					<Button id="LCTSelTimeout" class="LCTSelect" onactivate="LCTUIMenu('timeoutMs');">
						<Label id="LCTSelTimeoutLabel" class="LCTSelectLabel" text="8 秒" />
						<Label class="LCTSelectArrow" text="▼" />
					</Button>
				</Panel>
			</Panel>
			<Panel id="LCTMenuTimeout" class="LCTMenu">
				<Button class="LCTMenuOption" onactivate="LCTUIPick('timeoutMs','4000','4 秒');"><Label class="LCTMenuOptionLabel" text="4 秒" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('timeoutMs','8000','8 秒');"><Label class="LCTMenuOptionLabel" text="8 秒" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('timeoutMs','12000','12 秒');"><Label class="LCTMenuOptionLabel" text="12 秒" /></Button>
				<Button class="LCTMenuOption" onactivate="LCTUIPick('timeoutMs','16000','16 秒');"><Label class="LCTMenuOptionLabel" text="16 秒" /></Button>
			</Panel>
		</Panel>

		<Panel class="LCTFooter">
			<Panel id="LCTDot" class="LCTDot" />
			<Label id="LCTStatusText" class="LCTStatusText" text="未连接" />
		</Panel>
	</Panel>
</root>
