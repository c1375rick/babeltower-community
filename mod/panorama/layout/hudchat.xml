<?xml version="1.0" encoding="utf-8"?>
<!--
  BabelTower v3 — 大厅聊天布局覆盖
  结构取自原版 hudchat.xml 的反编译重建,保留原版 ID/class。
  与 chat.xml 一样作为脚本加载载体:settings.vjs_c(设置宿主)+ lc_protocol.vjs_c(协议客户端);
  两个 context 都会跑注入逻辑,通过全局面板树查重,只有一个会真正注入。
  内含隐藏协议面板 LCTNet(CitadelHTMLPanel,probe 实证形态,见 docs/PROTOCOL.md §2)。
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/hudchat.vcss_c" />
		<include src="s2r://panorama/styles/lct_net.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/lct_settings.vjs_c" />
		<include src="s2r://panorama/scripts/lc_protocol.vjs_c" />
	</scripts>
	<CitadelHudChat defaultfocus="ChatInput" hittest="false">
		<Panel id="FullChatContainer" hittest="false">
			<Panel id="ChatMainPanel" hittest="false">
				<Panel id="ChatLinesArea" hittest="false">
					<Panel id="ChatLinesContainer" hittest="false">
						<Panel id="ChatLinesWrapper" hittest="false">
							<Panel id="ChatLinesPanel" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="ChatLinesOverlay" hittest="false" />
				</Panel>
				<Panel id="ChatDisabled">
					<Label text="#Citadel_Hud_ChatDisabled" />
				</Panel>
				<Panel id="ChatControls">
					<Label id="ChatTargetLabel" text="#citadel_chat_placeholder" />
					<TextEntry id="ChatInput" onblur="CitadelChatTextBlur();" placeholder="" maxchars="1024" />
				</Panel>
			</Panel>
		</Panel>
		<!-- 隐藏协议面板:上行 SetURL / 下行 HTMLTitle,probe 实证的声明位置与形态 -->
		<CitadelHTMLPanel id="LCTNet" class="LCTNet" hittest="false" acceptsfocus="false" />
	</CitadelHudChat>
</root>
