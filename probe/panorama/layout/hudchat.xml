<?xml version="1.0" encoding="utf-8"?>
<!--
  LCT CEF PROBE — 大厅聊天布局(与 chat.xml 同一探针,互为覆盖)
  结构取自原版 hudchat.xml 的反编译重建,保留原版 ID/class。
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/hudchat.vcss_c" />
		<include src="s2r://panorama/styles/probe.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/probe.vjs_c" />
	</scripts>
	<CitadelHudChat defaultfocus="ChatInput" hittest="false">
		<Panel id="FullChatContainer" hittest="false">
			<Panel id="ChatMainPanel" hittest="false">
				<Panel id="ChatLinesArea" hittest="false">
					<Panel id="ChatLinesContainer" hittest="false">
						<Panel id="ChatLinesWrapper" hittest="false">
							<Panel id="ChatLinesPanel" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="ChatLinesOverlay" hittest="false" />
				</Panel>
				<Panel id="ChatDisabled">
					<Label text="#Citadel_Hud_ChatDisabled" />
				</Panel>
				<Panel id="ChatControls">
					<Label id="ChatTargetLabel" text="#citadel_chat_placeholder" />
					<TextEntry id="ChatInput" oninputsubmit="LCTOnChatSubmit();" onblur="CitadelChatTextBlur();" placeholder="" maxchars="1024" />
				</Panel>
			</Panel>
		</Panel>
		<CitadelHTMLPanel id="LCTProbe" class="LCTProbe" hittest="false" acceptsfocus="false" />
		<Panel id="LCTProbeBox" class="LCTProbeBox" hittest="false">
			<Label id="LCTProbeText" class="LCTProbeText" text="probe booting..." />
		</Panel>
	</CitadelHudChat>
</root>
